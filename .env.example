# Copy to .env.local and fill in.

# Postgres — matches docker-compose.yml defaults.
DATABASE_URL=postgres://simply_do:simply_do@localhost:5432/simply_do

# Hono API server port.
API_PORT=4000

# Public origin of the client (used by Better Auth for cookie + CORS).
APP_URL=http://localhost:5173

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemma via Ollama (used in Phase 5; safe to leave default for now).
GEMMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b
